{
  "name": "teacher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n content,next -c yellow,gray \"npm:content:watch\" \"next dev\"",
    "predev": "tsx scripts/db-migrate.ts",
    "build": "tsx scripts/db-migrate.ts && npm run content -- --force && next build",
    "start": "next start",
    "content": "tsx scripts/content.ts",
    "content:watch": "tsx scripts/content.ts --watch",
    "check": "tsx scripts/content.ts --check",
    "check:code": "tsx scripts/check-code.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "data:cf": "tsx scripts/fetch-codeforces.ts",
    "verify:problems": "tsx scripts/verify-problems.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hastscript": "^9.0.1",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "description": "teacher — a calm, interactive path from zero to Codeforces Candidate Master, plus System Design, LLD and AI engineering.",
  "engines": {
    "node": ">=20.9"
  }
}
