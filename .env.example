# Database (libSQL). Local default when unset in development: file:.data/teacher.db
# Production: a Turso database URL, e.g. libsql://teacher-yourname.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Better Auth — a long random string (openssl rand -base64 32). Required in production.
BETTER_AUTH_SECRET=
# Public URL of the site, e.g. https://teacher.netlify.app
BETTER_AUTH_URL=

# Optional social sign-in. Leave GitHub unset and the sign-in page hides the button.
# Create an OAuth app at https://github.com/settings/developers
# Production callback: https://teacherv0.netlify.app/api/auth/callback/github
# Local callback (a second OAuth app — GitHub allows one callback URL per app):
#   http://localhost:3000/api/auth/callback/github
# See docs/DEPLOYMENT.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Codeforces API key for signed requests. Public data works without it.
# Never commit real values.
CF_API_KEY=
CF_API_SECRET=
