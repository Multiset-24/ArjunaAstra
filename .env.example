# Database (libSQL). Local default when unset in development: file:.data/teacher.db
# Production: a Turso database URL, e.g. libsql://teacher-yourname.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Better Auth — a long random string (openssl rand -base64 32). Required in production.
# Set this in the Netlify runtime before merging; the build does not need it.
BETTER_AUTH_SECRET=
# Public URL of the site, e.g. https://teacher.netlify.app
BETTER_AUTH_URL=
# Canonical origin for metadata, robots, and the sitemap. Defaults to https://teacherv0.netlify.app
NEXT_PUBLIC_SITE_URL=

# Optional social sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Codeforces API key for signed requests. Public data works without it.
# Never commit real values.
CF_API_KEY=
CF_API_SECRET=
